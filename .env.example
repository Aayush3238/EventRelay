# Copy to .env and fill in. Never commit a real .env.
DATABASE_URL=postgres://eventrelay:eventrelay@localhost:5432/eventrelay
REDIS_URL=redis://localhost:6379
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development
LOG_LEVEL=info

# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me-in-production-at-least-32-random-chars
# Exactly 32 bytes, base64-encoded. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-base64-32-bytes-AAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Delivery / retry tuning (see plan.md §7.3 + §8.1)
MAX_ATTEMPTS=6
BASE_RETRY_DELAY_MS=5000
RETRY_MULTIPLIER=2
MAX_RETRY_DELAY_MS=3600000
# Must satisfy: DELIVERY_LEASE_MS >= (endpoint timeout * 3) + 10000. Startup fails fast otherwise.
DELIVERY_LEASE_MS=100000
MAX_ENDPOINT_TIMEOUT_MS=30000
WORKER_CONCURRENCY=10
RETRYABLE_STATUS_CODES=408,425,429
MAX_EVENT_PAYLOAD_BYTES=262144
MAX_RESPONSE_BYTES=65536

# SSRF safety valves. NEVER enable these in production (startup refuses).
ALLOW_LOCAL_ENDPOINTS=false
ALLOW_INSECURE_URLS=false
